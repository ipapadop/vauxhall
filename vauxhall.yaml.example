# Vauxhall Configuration Template
# Copy this file to vauxhall.yaml to customize your setup.

# MQTT Broker connection settings
mqtt:
  # Hostname or IP of the MQTT broker (default: localhost)
  host: "localhost"
  # Port for MQTT connection (default: 1883)
  port: 1883
  # Keepalive interval in seconds (default: 60)
  keepalive: 60

# Dashboard UI settings
dashboard:
  # Title displayed in the dashboard window
  window_title: "Vauxhall Agent Dashboard"
  # Initial width of the dashboard window in pixels
  width: 1000
  # Initial height of the dashboard window in pixels
  height: 800
  # Threshold in seconds before a metric is considered stale (default: 120)
  stale_threshold: 120

# Logging configuration
logging:
  # Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
  level: "INFO"
